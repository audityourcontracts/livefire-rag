{
  "schema_version": "livefire.rag.generic-evidence-projection-policy/1",
  "relation_document_kinds": {
    "ocsf_api_activity": "activity",
    "ocsf_application_lifecycle": "activity",
    "ocsf_authentication": "activity",
    "ocsf_cloud_resources_inventory_info": "state",
    "ocsf_datastore_activity": "activity",
    "ocsf_detection_finding": "detection",
    "ocsf_dns_activity": "activity",
    "ocsf_email_activity": "activity",
    "ocsf_entity_management": "activity",
    "ocsf_event_log_activity": "activity",
    "ocsf_ext_livefire_configuration_snapshot": "state",
    "ocsf_ext_livefire_system_metric": "structured_only",
    "ocsf_file_activity": "activity",
    "ocsf_http_activity": "activity",
    "ocsf_inventory_info": "state",
    "ocsf_network_activity": "activity",
    "ocsf_process_activity": "activity",
    "ocsf_user_inventory": "state"
  },
  "derivation_only_relations": [
    "ocsf_ext_livefire_system_metric"
  ],
  "bounds": {
    "max_leaves": 160,
    "max_list_items": 24,
    "max_value_chars": 240,
    "max_facet_text_chars": 1024,
    "max_semantic_text_chars": 3072,
    "max_exact_attributes": 256,
    "max_exact_scalars_scanned": 512,
    "max_exact_list_items": 64,
    "max_exact_string_utf8_bytes": 1024,
    "max_exact_path_chars": 1024
  },
  "identity_policy": {
    "semantic_group_excludes": [
      "event_id",
      "event_time",
      "support_ref",
      "typed_identifiers",
      "secret_values"
    ],
    "exact_attribute_contract": "bounded_value_exact_typed_json_scalar_subset_hydrate_source_for_omissions",
    "exact_attribute_path": "rfc6901_json_pointer",
    "exact_attribute_inclusions": [
      "booleans",
      "jcs_safe_integers",
      "finite_numbers",
      "safe_bounded_strings"
    ],
    "exact_attribute_omissions": [
      "null_values",
      "secret_fields",
      "unsafe_credential_values",
      "free_text_fields",
      "oversize_strings",
      "oversize_paths",
      "non_finite_numbers",
      "non_jcs_safe_integers",
      "attribute_or_scan_bounds"
    ],
    "secret_values": "excluded_from_exact_attributes_and_sha256_digest_only_in_semantic_receipt",
    "field_name_normalization": "camel_case_and_punctuation_to_lower_snake_case",
    "identifier_suffixes": [
      "_id",
      "_uid",
      "_pid",
      "_gid",
      "_sid",
      "_ref",
      "_sha256",
      "_hash",
      "_identifier",
      "_address",
      "_ip",
      "_arn",
      "_uuid"
    ],
    "identifier_leaf_names": [
      "account",
      "actor",
      "actor_aliases",
      "address",
      "addresses",
      "auid",
      "credential_id",
      "device",
      "domain",
      "dst_ip",
      "egid",
      "email",
      "euid",
      "event_id",
      "gid",
      "host",
      "host_identifier",
      "host_uuid",
      "hostname",
      "identities",
      "identity",
      "interface",
      "message_trace_uid",
      "message_uid",
      "native_event_uid",
      "parent_process_uid",
      "pid",
      "ppid",
      "principal",
      "recipients",
      "record_uid",
      "request_id",
      "resource",
      "resources",
      "rgid",
      "ruid",
      "sender",
      "session_id",
      "sid",
      "source_address",
      "src_ip",
      "subject",
      "support_ref",
      "target",
      "uid",
      "user",
      "uuid"
    ],
    "time_leaf_names": [
      "atime",
      "btime",
      "calendar_time",
      "ctime",
      "end_time",
      "event_time",
      "mtime",
      "observed_time",
      "start_time",
      "time",
      "timestamp",
      "unix_time",
      "uptime"
    ],
    "volatile_leaf_names": [
      "counter",
      "epoch",
      "line_number",
      "ordinal",
      "record_number",
      "sequence",
      "sequence_number"
    ],
    "free_text_leaf_names": [
      "body",
      "cmd_line",
      "command",
      "command_line",
      "content",
      "description",
      "details",
      "headers",
      "message",
      "payload",
      "query",
      "raw",
      "request",
      "script",
      "script_block",
      "stack_trace",
      "user_agent"
    ],
    "excluded_path_families": [
      "unmapped.$token/<ordinal>"
    ],
    "secret_leaf_names": [
      "access_token",
      "api_key",
      "auth_token",
      "authorization",
      "client_secret",
      "cookie",
      "passwd",
      "password",
      "private_key",
      "refresh_token",
      "secret",
      "secret_key",
      "session_token",
      "token"
    ],
    "secret_suffixes": [
      "_secret",
      "_password",
      "_token"
    ]
  },
  "selection_policy": "closed_typed_relation_set_without_event-value_predicates",
  "unknown_or_unparsed_policy": "structured_only_occurrence"
}
