{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://livefire.dev/rag/semantic-result.v1.schema.json",
  "title": "Livefire RAG semantic pointer or miss result v1",
  "oneOf": [
    {"$ref": "#/$defs/pointer_result"},
    {"$ref": "#/$defs/miss_result"}
  ],
  "$defs": {
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "indexed_commands", "eligible_commands", "requested_top_n", "returned_count", "exhausted"],
      "properties": {
        "status": {"enum": ["complete", "partial", "unavailable"]},
        "indexed_commands": {"type": "integer", "minimum": 0},
        "eligible_commands": {"type": "integer", "minimum": 0},
        "requested_top_n": {"type": "integer", "minimum": 1},
        "returned_count": {"type": "integer", "minimum": 0},
        "exhausted": {"type": "boolean"}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rank", "command_id", "cosine_distance_millionths", "preview", "source_ref", "metadata"],
      "properties": {
        "rank": {"type": "integer", "minimum": 1},
        "command_id": {"type": "string", "minLength": 1},
        "cosine_distance_millionths": {"type": "integer", "minimum": 0, "maximum": 2000000},
        "preview": {"type": "string", "maxLength": 4096},
        "source_ref": {"$ref": "https://livefire.dev/sdk/source-record-pointer.v1.schema.json"},
        "metadata": {"type": "object"}
      }
    },
    "pointer_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "kind", "tool", "index", "pointers", "coverage"],
      "properties": {
        "schema_version": {"const": "livefire.rag.semantic-result/1"},
        "kind": {"const": "pointer"},
        "tool": {"enum": ["cli.search", "cli.similar"]},
        "index": {"$ref": "https://livefire.dev/sdk/component-ref.v1.schema.json"},
        "pointers": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/candidate"}},
        "coverage": {"$ref": "#/$defs/coverage"}
      }
    },
    "miss_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "kind", "tool", "index", "reason", "coverage"],
      "properties": {
        "schema_version": {"const": "livefire.rag.semantic-result/1"},
        "kind": {"const": "miss"},
        "tool": {"enum": ["cli.search", "cli.similar"]},
        "index": {"$ref": "https://livefire.dev/sdk/component-ref.v1.schema.json"},
        "reason": {"type": "string", "minLength": 1},
        "coverage": {"$ref": "#/$defs/coverage"}
      }
    }
  }
}
