{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://livefire.dev/rag/prepared-occurrence-row.v1.schema.json",
  "title": "Prepared occurrence row v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["occurrence_id", "document_id", "event_time_ms", "relation", "source_row_ordinal", "exact_attributes_json", "snapshot_sha256", "mapping_sha256", "event_id", "support_ref"],
  "properties": {
    "occurrence_id": {"type": "string", "minLength": 1},
    "document_id": {"type": "string", "minLength": 1},
    "event_time_ms": {"type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991},
    "relation": {"type": "string", "minLength": 1},
    "source_row_ordinal": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "exact_attributes_json": {"type": "string", "minLength": 2},
    "snapshot_sha256": {"$ref": "#/$defs/sha256"},
    "mapping_sha256": {"$ref": "#/$defs/sha256"},
    "event_id": {"type": "string", "minLength": 1},
    "support_ref": {"type": "string", "minLength": 1}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
  "$comment": "Rows are stored in Parquet. Contract validation requires exact_attributes_json to use canonical JSON."
}
