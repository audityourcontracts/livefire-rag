{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://livefire.dev/rag/evidence-coverage-report.v1.schema.json",
  "title": "Livefire generic evidence index closure and coverage report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_snapshots",
    "projection_policy",
    "closure",
    "documents",
    "relation_coverage",
    "pointer_resolution",
    "reason_counts"
  ],
  "properties": {
    "schema_version": {"const": "livefire.rag.evidence-coverage-report/1"},
    "source_snapshots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "https://livefire.dev/sdk/component-ref.v1.schema.json"}
    },
    "projection_policy": {"$ref": "https://livefire.dev/sdk/component-ref.v1.schema.json"},
    "derivation_policies": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "https://livefire.dev/sdk/component-ref.v1.schema.json"}
    },
    "closure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_record_count",
        "terminal_disposition_count",
        "unaccounted_record_count",
        "multiply_dispositioned_record_count",
        "all_source_records_dispositioned"
      ],
      "properties": {
        "source_record_count": {"type": "integer", "minimum": 0},
        "terminal_disposition_count": {"type": "integer", "minimum": 0},
        "unaccounted_record_count": {"const": 0},
        "multiply_dispositioned_record_count": {"const": 0},
        "all_source_records_dispositioned": {"const": true},
        "by_terminal_disposition": {"$ref": "#/$defs/disposition_counts"}
      }
    },
    "documents": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "searchable", "by_kind"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "searchable": {"type": "integer", "minimum": 0},
        "by_kind": {"$ref": "#/$defs/document_kind_counts"}
      }
    },
    "relation_coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relation_identity", "source_record_count", "terminal_disposition_count", "by_terminal_disposition"],
        "properties": {
          "relation_identity": {"$ref": "https://livefire.dev/rag/evidence-common.v1.schema.json#/$defs/relation_identity"},
          "source_record_count": {"type": "integer", "minimum": 0},
          "terminal_disposition_count": {"type": "integer", "minimum": 0},
          "by_terminal_disposition": {"$ref": "#/$defs/disposition_counts"}
        }
      }
    },
    "pointer_resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pointer_count", "resolved_count", "unresolved_count", "all_pointers_resolved"],
      "properties": {
        "pointer_count": {"type": "integer", "minimum": 0},
        "resolved_count": {"type": "integer", "minimum": 0},
        "unresolved_count": {"const": 0},
        "all_pointers_resolved": {"const": true}
      }
    },
    "reason_counts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["terminal_disposition", "reason_code", "count"],
        "properties": {
          "terminal_disposition": {"$ref": "https://livefire.dev/rag/evidence-common.v1.schema.json#/$defs/terminal_disposition"},
          "reason_code": {"type": "string", "minLength": 1, "maxLength": 256},
          "count": {"type": "integer", "minimum": 1}
        }
      }
    }
  },
  "$defs": {
    "disposition_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "direct_semantic_document",
        "semantic_group_occurrence",
        "derived_document_input",
        "structured_only_occurrence",
        "rejected"
      ],
      "properties": {
        "direct_semantic_document": {"type": "integer", "minimum": 0},
        "semantic_group_occurrence": {"type": "integer", "minimum": 0},
        "derived_document_input": {"type": "integer", "minimum": 0},
        "structured_only_occurrence": {"type": "integer", "minimum": 0},
        "rejected": {"type": "integer", "minimum": 0}
      }
    },
    "document_kind_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activity", "state", "state_transition", "metric_window", "network_window", "entity", "detection", "structured_only"],
      "properties": {
        "activity": {"type": "integer", "minimum": 0},
        "state": {"type": "integer", "minimum": 0},
        "state_transition": {"type": "integer", "minimum": 0},
        "metric_window": {"type": "integer", "minimum": 0},
        "network_window": {"type": "integer", "minimum": 0},
        "entity": {"type": "integer", "minimum": 0},
        "detection": {"type": "integer", "minimum": 0},
        "structured_only": {"type": "integer", "minimum": 0}
      }
    }
  }
}
