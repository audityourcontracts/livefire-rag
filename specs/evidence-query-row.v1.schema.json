{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://livefire.dev/rag/evidence-query-row.v1.schema.json",
  "title": "Evaluator-only fact-to-evidence query row v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "query_id", "fact_id", "domain", "cohort", "resampling_cluster_id", "incident_id", "scope_ids", "split", "surface", "eligibility", "status", "query_text", "query_text_sha256", "source_fact_sha256"],
  "properties": {
    "schema_version": {"const": "livefire.rag.evidence-query-row/1"},
    "query_id": {"type": "string", "minLength": 1},
    "fact_id": {"type": "string", "minLength": 1},
    "domain": {"type": "string", "minLength": 1},
    "cohort": {"enum": ["cloud", "bots_native", "external"]},
    "resampling_cluster_id": {"type": "string", "minLength": 1},
    "incident_id": {"type": "string", "minLength": 1},
    "phase_id": {"type": "string", "minLength": 1},
    "scope_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "split": {"enum": ["development", "validation", "test"]},
    "surface": {"enum": ["canonical_fact", "analyst_question", "terse_soc", "entity_light_paraphrase"]},
    "eligibility": {"enum": ["eligible", "outside_index_domain", "external_enrichment", "metadata_only", "composite_only", "unresolved"]},
    "status": {"enum": ["active", "excluded", "unresolved"]},
    "query_text": {"type": "string", "minLength": 1, "maxLength": 8192},
    "query_text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "expected_top_k_cardinality": {"type": "integer", "minimum": 0, "maximum": 20, "description": "Independently computed min(20, eligible corpus cardinality) after sealed query filters."},
    "candidate_universe_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "exclusion_reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "source_fact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "active"}}}, "then": {"properties": {"eligibility": {"const": "eligible"}}, "required": ["expected_top_k_cardinality", "candidate_universe_receipt_sha256"]}},
    {"if": {"properties": {"status": {"enum": ["excluded", "unresolved"]}}}, "then": {"required": ["exclusion_reason_codes"]}},
    {"if": {"properties": {"eligibility": {"const": "unresolved"}}}, "then": {"properties": {"status": {"const": "unresolved"}}}}
  ]
}
