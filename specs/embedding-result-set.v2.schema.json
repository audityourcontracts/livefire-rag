{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://livefire.dev/rag/embedding-result-set.v2.schema.json",
  "title": "Test-only embedding result set manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "component_sha256", "plan_sha256", "prepared_corpus_sha256", "embedding_profile_sha256", "document_count", "document_order_sha256", "receipts", "test_only"],
  "properties": {
    "schema_version": {"const": "livefire.rag.embedding-result-set/2"},
    "component_sha256": {"$ref": "#/$defs/sha256"},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "prepared_corpus_sha256": {"$ref": "#/$defs/sha256"},
    "embedding_profile_sha256": {"$ref": "#/$defs/sha256"},
    "document_count": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "document_order_sha256": {"$ref": "#/$defs/sha256"},
    "receipts": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["task_id", "path", "sha256"], "properties": {"task_id": {"type": "string", "minLength": 1}, "path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/sha256"}}}},
    "test_only": {"const": true}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)(?!.*:)(?!.*[/]$).+$"}
  },
  "$comment": "Version 2 is reserved for deterministic test vectors. Normal model-produced result sets remain version 1."
}
