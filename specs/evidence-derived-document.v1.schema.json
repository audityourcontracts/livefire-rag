{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://livefire.dev/rag/evidence-derived-document.v1.schema.json",
  "title": "Livefire derived evidence overlay document v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_id",
    "document_sha256",
    "document_kind",
    "representation",
    "searchable",
    "source_snapshot",
    "base_projection_pack",
    "derivation_policy",
    "relation_identities",
    "semantic_projection",
    "derivation",
    "occurrence_count"
  ],
  "properties": {
    "schema_version": {"const": "livefire.rag.evidence-derived-document/1"},
    "document_id": {"type": "string", "pattern": "^ddoc-[0-9a-f]{64}$"},
    "document_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "document_kind": {"enum": ["metric_window", "network_window", "state_transition", "entity"]},
    "representation": {"const": "derived"},
    "searchable": {"const": true},
    "source_snapshot": {"$ref": "https://livefire.dev/sdk/component-ref.v1.schema.json"},
    "base_projection_pack": {"$ref": "https://livefire.dev/sdk/component-ref.v1.schema.json"},
    "derivation_policy": {"$ref": "https://livefire.dev/sdk/component-ref.v1.schema.json"},
    "relation_identities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "https://livefire.dev/rag/evidence-common.v1.schema.json#/$defs/relation_identity"}
    },
    "time_range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "bounds"],
      "properties": {
        "start": {"type": "string", "format": "date-time"},
        "end": {"type": "string", "format": "date-time"},
        "bounds": {"const": "start_inclusive_end_exclusive"}
      }
    },
    "semantic_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "facets"],
      "properties": {
        "text": {"type": "string", "minLength": 1, "maxLength": 3072},
        "facets": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "values"],
            "properties": {
              "name": {"type": "string", "minLength": 1, "maxLength": 128},
              "values": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1, "maxLength": 1024}
              }
            }
          }
        }
      }
    },
    "derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "group_sha256",
        "input_count",
        "input_set_sha256",
        "closure_state",
        "completeness_state",
        "aggregate_material"
      ],
      "properties": {
        "group_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "input_count": {"type": "integer", "minimum": 1},
        "input_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "closure_state": {"type": "string", "minLength": 1, "maxLength": 256},
        "completeness_state": {"type": "string", "minLength": 1, "maxLength": 256},
        "aggregate_material": {"type": "object"}
      }
    },
    "occurrence_count": {"type": "integer", "minimum": 1}
  }
}
