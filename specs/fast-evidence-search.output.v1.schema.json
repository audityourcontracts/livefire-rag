{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://livefire.dev/rag/fast-evidence-search.output.v1.schema.json",
  "title": "Fast experimental evidence search output v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "tool", "index", "source_snapshots", "query", "coverage", "selection"],
  "properties": {
    "schema_version": {"const": "livefire.rag.fast-search.output/1"},
    "kind": {"enum": ["pointer", "miss"]},
    "tool": {"const": "evidence.search"},
    "index": {"$ref": "https://livefire.dev/sdk/component-ref.v1.schema.json"},
    "source_snapshots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "https://livefire.dev/sdk/component-ref.v1.schema.json"}
    },
    "query": {"type": "string", "minLength": 1, "maxLength": 8192},
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "indexed_documents", "definitive", "reason_codes"],
      "properties": {
        "status": {"enum": ["complete", "partial"]},
        "indexed_documents": {"type": "integer", "minimum": 1},
        "definitive": {"const": false},
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested_top_n", "returned_count", "deterministic", "tie_break"],
      "properties": {
        "requested_top_n": {"type": "integer", "minimum": 1, "maximum": 100},
        "returned_count": {"type": "integer", "minimum": 0, "maximum": 100},
        "deterministic": {"const": true},
        "tie_break": {"const": "score_desc_document_id_asc"}
      }
    },
    "miss": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "message"],
      "properties": {
        "reason": {"enum": ["no_ranked_candidates"]},
        "message": {"type": "string", "minLength": 1, "maxLength": 1024}
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {"$ref": "#/$defs/candidate"}
    }
  },
  "oneOf": [
    {"properties": {"kind": {"const": "pointer"}}, "required": ["candidates"], "not": {"required": ["miss"]}},
    {"properties": {"kind": {"const": "miss"}}, "required": ["miss"], "not": {"required": ["candidates"]}}
  ],
  "$defs": {
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot_sha256", "mapping_sha256", "event_id", "support_ref"],
      "properties": {
        "snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "mapping_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "event_id": {"type": "string", "minLength": 1},
        "support_ref": {"type": "string", "minLength": 1}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rank", "document_id", "scores", "eligible_evidence_count", "evidence_exhausted", "evidence"],
      "properties": {
        "rank": {"type": "integer", "minimum": 1},
        "document_id": {"type": "string", "minLength": 1},
        "scores": {
          "type": "object",
          "additionalProperties": false,
          "required": ["retrieval", "dense", "lexical"],
          "properties": {
            "retrieval": {"type": "number"},
            "dense": {"type": ["number", "null"]},
            "lexical": {"type": ["number", "null"]}
          }
        },
        "eligible_evidence_count": {"type": "integer", "minimum": 1},
        "evidence_exhausted": {"type": "boolean"},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {"$ref": "#/$defs/evidence_ref"}
        }
      }
    }
  }
}
