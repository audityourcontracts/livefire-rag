{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://livefire.dev/rag/embedding-result-set.v3.schema.json",
  "title": "Locally derived embedding result set manifest v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "component_sha256", "plan_sha256", "prepared_corpus_sha256", "embedding_profile_sha256", "document_count", "document_order_sha256", "receipts", "derivation"],
  "properties": {
    "schema_version": {"const": "livefire.rag.embedding-result-set/3"},
    "component_sha256": {"$ref": "#/$defs/sha256"},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "prepared_corpus_sha256": {"$ref": "#/$defs/sha256"},
    "embedding_profile_sha256": {"$ref": "#/$defs/sha256"},
    "document_count": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "document_order_sha256": {"$ref": "#/$defs/sha256"},
    "receipts": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["task_id", "path", "sha256"], "properties": {"task_id": {"type": "string", "minLength": 1}, "path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/sha256"}}}},
    "derivation": {"type": "object", "additionalProperties": false, "required": ["parent_embedding_profile_sha256", "parent_result_set_sha256", "parent_dimensions", "transformation"], "properties": {"parent_embedding_profile_sha256": {"$ref": "#/$defs/sha256"}, "parent_result_set_sha256": {"$ref": "#/$defs/sha256"}, "parent_dimensions": {"const": 4096}, "transformation": {"const": "prefix_then_l2_normalize_v1"}}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)(?!.*:)(?!.*[/]$).+$"}
  },
  "$comment": "Runtime validation requires one derived receipt for every plan task and matches every receipt to this parent result and profile."
}
