{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://livefire.dev/rag/prepared-document-row.v1.schema.json",
  "title": "Prepared document row v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["document_ordinal", "document_id", "document_sha256", "semantic_text_sha256", "semantic_text", "document_kind", "primary_relation", "facets_json", "relations_json", "occurrence_count"],
  "properties": {
    "document_ordinal": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "document_id": {"type": "string", "minLength": 1},
    "document_sha256": {"$ref": "#/$defs/sha256"},
    "semantic_text_sha256": {"$ref": "#/$defs/sha256"},
    "semantic_text": {"type": "string", "minLength": 1},
    "document_kind": {"enum": ["activity", "state", "detection"]},
    "primary_relation": {"type": "string", "minLength": 1},
    "facets_json": {"type": "string", "minLength": 2},
    "relations_json": {"type": "string", "minLength": 2},
    "occurrence_count": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
  "$comment": "Rows are stored in Parquet. Contract validation requires canonical JSON strings, the semantic text hash to match, and contiguous document ordinals in corpus order."
}
