{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.livefire.dev/rag/tokenizer-parity-fixture.v1.schema.json",
  "title": "Tokenizer parity fixture v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "cases", "generated_cases"],
  "properties": {
    "schema_version": {"const": "livefire.rag.tokenizer-parity-fixture/1"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "model_file", "model_revision", "source_tokenizer_json_revision", "source_tokenizer_json_sha256", "executable_tokenizer_json_sha256", "add_special_tokens"],
      "properties": {
        "runtime": {"type": "string", "minLength": 1},
        "model_file": {"type": "string", "minLength": 1},
        "model_revision": {"type": "string", "minLength": 1},
        "source_tokenizer_json_revision": {"type": "string", "minLength": 1},
        "source_tokenizer_json_sha256": {"$ref": "#/$defs/sha256"},
        "executable_tokenizer_json_sha256": {"$ref": "#/$defs/sha256"},
        "add_special_tokens": {"const": true}
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "input", "token_ids"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "input": {"type": "string"},
          "token_ids": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0, "maximum": 4294967295}}
        }
      }
    },
    "generated_cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "repeat", "count", "token_count", "token_ids_u32le_sha256"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "repeat": {"type": "string", "minLength": 1},
          "count": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
          "token_count": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
          "token_ids_u32le_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
