{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://livefire.dev/rag/command-index-manifest.v1.schema.json",
  "title": "Livefire immutable command index manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "base_index_manifest", "index_format_descriptor", "physical_profile", "source_snapshots", "comparison_universe", "comparison_universe_schema", "command_record_schema", "row_schemas", "projection_policy", "powershell_analysis_policy", "anomaly_policy", "embedding_profiles", "objects", "coverage", "query_engine_contract"],
  "properties": {
    "schema_version": {"const": "livefire.rag.command-index/1"},
    "base_index_manifest": {"$ref": "https://livefire.dev/sdk/component-ref.v1.schema.json"},
    "index_format_descriptor": {"$ref": "https://livefire.dev/sdk/component-ref.v1.schema.json"},
    "physical_profile": {"$ref": "https://livefire.dev/sdk/component-ref.v1.schema.json"},
    "source_snapshots": {"type": "array", "minItems": 1, "items": {"$ref": "https://livefire.dev/sdk/component-ref.v1.schema.json"}},
    "comparison_universe": {"$ref": "https://livefire.dev/sdk/component-ref.v1.schema.json"},
    "comparison_universe_schema": {"$ref": "https://livefire.dev/sdk/component-ref.v1.schema.json"},
    "command_record_schema": {"$ref": "https://livefire.dev/sdk/component-ref.v1.schema.json"},
    "row_schemas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command_document", "powershell_ast_document", "embedding_row", "outlier_score_row", "comparison_row"],
      "properties": {
        "command_document": {"$ref": "https://livefire.dev/sdk/component-ref.v1.schema.json"},
        "powershell_ast_document": {"$ref": "https://livefire.dev/sdk/component-ref.v1.schema.json"},
        "embedding_row": {"$ref": "https://livefire.dev/sdk/component-ref.v1.schema.json"},
        "outlier_score_row": {"$ref": "https://livefire.dev/sdk/component-ref.v1.schema.json"},
        "comparison_row": {"$ref": "https://livefire.dev/sdk/component-ref.v1.schema.json"}
      }
    },
    "projection_policy": {"$ref": "https://livefire.dev/sdk/component-ref.v1.schema.json"},
    "powershell_analysis_policy": {"$ref": "https://livefire.dev/sdk/component-ref.v1.schema.json"},
    "anomaly_policy": {"$ref": "https://livefire.dev/sdk/component-ref.v1.schema.json"},
    "embedding_profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantic_search", "action_novelty", "target_novelty"],
      "properties": {
        "semantic_search": {"$ref": "https://livefire.dev/sdk/component-ref.v1.schema.json"},
        "action_novelty": {"$ref": "https://livefire.dev/sdk/component-ref.v1.schema.json"},
        "target_novelty": {"$ref": "https://livefire.dev/sdk/component-ref.v1.schema.json"}
      }
    },
    "objects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commands", "powershell_asts", "embeddings", "outlier_scores", "comparisons", "object_lock"],
      "properties": {
        "commands": {"$ref": "https://livefire.dev/sdk/artifact-ref.v1.schema.json"},
        "powershell_asts": {"$ref": "https://livefire.dev/sdk/artifact-ref.v1.schema.json"},
        "embeddings": {"$ref": "https://livefire.dev/sdk/artifact-ref.v1.schema.json"},
        "outlier_scores": {"$ref": "https://livefire.dev/sdk/artifact-ref.v1.schema.json"},
        "comparisons": {"$ref": "https://livefire.dev/sdk/artifact-ref.v1.schema.json"},
        "object_lock": {"$ref": "https://livefire.dev/sdk/artifact-ref.v1.schema.json"}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_records", "indexed_commands", "principal_identified", "principal_unavailable", "powershell_commands", "decoded_commands", "scored_principal", "scored_population", "excluded_records"],
      "properties": {
        "source_records": {"type": "integer", "minimum": 0},
        "indexed_commands": {"type": "integer", "minimum": 0},
        "principal_identified": {"type": "integer", "minimum": 0},
        "principal_unavailable": {"type": "integer", "minimum": 0},
        "powershell_commands": {"type": "integer", "minimum": 0},
        "decoded_commands": {"type": "integer", "minimum": 0},
        "scored_principal": {"type": "integer", "minimum": 0},
        "scored_population": {"type": "integer", "minimum": 0},
        "excluded_records": {"type": "integer", "minimum": 0},
        "left_censored": {"type": "boolean"}
      }
    },
    "query_engine_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_format", "vector_element_type", "vector_normalization", "accumulation", "distance", "distance_encoding", "tie_break", "derived_caches_authoritative"],
      "properties": {
        "canonical_format": {"const": "parquet"},
        "vector_element_type": {"const": "float32"},
        "vector_normalization": {"const": "l2"},
        "accumulation": {"const": "float64"},
        "distance": {"const": "cosine"},
        "distance_encoding": {"const": "round_half_even_distance_times_1000000"},
        "tie_break": {"const": "distance_asc_command_id_asc"},
        "derived_caches_authoritative": {"const": false}
      }
    }
  }
}
