{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://livefire.dev/rag/dataset-catalogue.v1.schema.json",
  "title": "Modular dataset index catalogue v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "component_sha256", "mode", "source_snapshot", "mapping",
    "projection_policy", "embedding_profile", "query_compatibility", "rank_merge",
    "datasets", "allowed_relation_overlaps"
  ],
  "properties": {
    "schema_version": {"const": "livefire.rag.dataset-catalogue/1"},
    "component_sha256": {"$ref": "#/$defs/sha256"},
    "mode": {"enum": ["normal", "test_only"]},
    "source_snapshot": {"$ref": "portable-component-ref.v1.schema.json"},
    "mapping": {"$ref": "portable-component-ref.v1.schema.json"},
    "projection_policy": {"$ref": "portable-component-ref.v1.schema.json"},
    "embedding_profile": {"$ref": "portable-component-ref.v1.schema.json"},
    "query_compatibility": {"const": "single_embedding_profile"},
    "rank_merge": {"const": "reciprocal_rank_fusion_v1"},
    "datasets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/dataset"}},
    "allowed_relation_overlaps": {
      "type": "array",
      "items": {"$ref": "#/$defs/overlap_allowance"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "safe_positive": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?:(?!\\.\\.?(?:/|$))[^/\\\\:\\u0000]+/)*(?!\\.\\.?$)[^/\\\\:\\u0000]+$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "id", "version", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset", "dataset_sha256", "projection_policy", "prepared_corpus",
        "embedding_plan", "embedding_result_set", "embedding_profile", "final_index",
        "searchable_document_count", "searchable_reference_count", "test_only"
      ],
      "properties": {
        "dataset": {"$ref": "portable-dataset-identity.v1.schema.json"},
        "dataset_sha256": {"$ref": "#/$defs/sha256"},
        "projection_policy": {"$ref": "portable-component-ref.v1.schema.json"},
        "prepared_corpus": {"$ref": "#/$defs/artifact"},
        "embedding_plan": {"$ref": "#/$defs/artifact"},
        "embedding_result_set": {"$ref": "#/$defs/artifact"},
        "embedding_profile": {"$ref": "portable-component-ref.v1.schema.json"},
        "final_index": {"$ref": "#/$defs/artifact"},
        "searchable_document_count": {"$ref": "#/$defs/safe_positive"},
        "searchable_reference_count": {"$ref": "#/$defs/safe_positive"},
        "test_only": {"type": "boolean"}
      }
    },
    "overlap_allowance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relation", "dataset_ids", "reason"],
      "properties": {
        "relation": {"type": "string", "minLength": 1},
        "dataset_ids": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "reason": {"type": "string", "minLength": 1}
      }
    }
  },
  "$comment": "Runtime validation requires datasets, relations, and overlap allowances to be deterministically sorted; dataset IDs and artifact paths to be unique; every dataset to bind the catalogue source snapshot, mapping, projection policy, and embedding profile; every included relation overlap to have one exact allowance; all counts to be safe and closed; normal mode to contain no test-vector indexes; test-only mode to contain only test-vector indexes; and component_sha256 to match RFC 8785 canonical JSON with that field omitted. Pipeline binding validation additionally loads and checks each prepared corpus, embedding plan, and embedding result set. Final-index admission must compare its loaded component digest and searchable counts to the catalogue entry."
}
