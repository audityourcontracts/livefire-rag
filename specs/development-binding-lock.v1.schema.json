{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://livefire.dev/rag/development-binding-lock.v1.schema.json",
  "title": "Development-only RAG provider binding receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "warning",
    "provider",
    "tools",
    "input_schemas",
    "output_schema",
    "index",
    "index_format",
    "source_snapshots",
    "embedding_profile_sha256",
    "query_time_contract",
    "limits",
    "result_semantics"
  ],
  "properties": {
    "schema_version": {"const": "livefire.rag.development-binding-lock/1"},
    "status": {"const": "development_only_not_admitted"},
    "warning": {"type": "string", "minLength": 1},
    "provider": {"$ref": "https://livefire.dev/sdk/component-ref.v1.schema.json"},
    "tools": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "https://livefire.dev/sdk/component-ref.v1.schema.json"}
    },
    "input_schemas": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "https://livefire.dev/sdk/component-ref.v1.schema.json"}
    },
    "output_schema": {"$ref": "https://livefire.dev/sdk/component-ref.v1.schema.json"},
    "index": {"$ref": "https://livefire.dev/sdk/component-ref.v1.schema.json"},
    "index_format": {"$ref": "https://livefire.dev/sdk/component-ref.v1.schema.json"},
    "source_snapshots": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "https://livefire.dev/sdk/component-ref.v1.schema.json"}
    },
    "embedding_profile_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "query_time_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network", "api_contract", "api_model_key"],
      "properties": {
        "network": {"const": "loopback_only"},
        "api_contract": {"type": "string", "minLength": 1},
        "api_model_key": {"type": "string", "minLength": 1}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result_bytes", "wall_time_ms"],
      "properties": {
        "result_bytes": {"type": "integer", "minimum": 1},
        "wall_time_ms": {"type": "integer", "minimum": 1}
      }
    },
    "result_semantics": {"const": "candidate_pointer_or_miss_never_evidence"}
  }
}
