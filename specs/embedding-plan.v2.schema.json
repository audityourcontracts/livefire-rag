{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://livefire.dev/rag/embedding-plan.v2.schema.json",
  "title": "Token-balanced portable embedding plan v2",
  "$comment": "The token-count object is one unsigned 32-bit little-endian count per absolute document ordinal at the fixed path token-counts/document-token-counts.u32le. document_token_counts_sha256 is SHA-256 over UTF-8 livefire.rag.document-token-counts/1 followed by NUL, then each absolute ordinal as u64le and count as u32le. Percentiles use nearest-rank order statistics. Runtime validation recomputes the file hash, logical digest, plan/task/slice totals and maxima, statistics, and all task boundaries. task_id is SHA-256 over RFC 8785 canonical JSON for an object containing schema_version=livefire.rag.embedding-task/2, prepared_corpus_sha256, embedding_profile_sha256, tokenizer_sha256, ordinal_start, ordinal_end, embedding_input_order_sha256, document_token_counts_sha256, and token_count.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "component_sha256", "prepared_corpus_sha256", "dataset",
    "embedding_profile", "executable_tokenizer", "document_count",
    "document_order_sha256", "document_token_counts_sha256",
    "document_token_counts_object", "token_statistics",
    "maximum_task_tokens", "maximum_task_documents", "tasks"
  ],
  "properties": {
    "schema_version": {"const": "livefire.rag.embedding-plan/2"},
    "component_sha256": {"$ref": "#/$defs/sha256"},
    "prepared_corpus_sha256": {"$ref": "#/$defs/sha256"},
    "dataset": {"$ref": "portable-dataset-identity.v1.schema.json"},
    "embedding_profile": {"$ref": "#/$defs/profile"},
    "executable_tokenizer": {"$ref": "#/$defs/executable_tokenizer"},
    "document_count": {"$ref": "#/$defs/safe_nonnegative"},
    "document_order_sha256": {"$ref": "#/$defs/sha256"},
    "document_token_counts_sha256": {"$ref": "#/$defs/sha256"},
    "document_token_counts_object": {"$ref": "#/$defs/token_count_object"},
    "token_statistics": {"$ref": "#/$defs/token_statistics"},
    "maximum_task_tokens": {"$ref": "#/$defs/safe_positive"},
    "maximum_task_documents": {"type": "integer", "minimum": 1, "maximum": 4294967295},
    "tasks": {"type": "array", "items": {"$ref": "#/$defs/task"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "safe_nonnegative": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "safe_positive": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?:(?!\\.\\.?(?:/|$))[^/\\\\:\\u0000]+/)*(?!\\.\\.?$)[^/\\\\:\\u0000]+$"
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "version", "sha256", "model_artifact", "tokenizer",
        "maximum_input_tokens", "pooling", "normalization", "dimensions",
        "dtype", "document_format"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "model_artifact": {"$ref": "portable-component-ref.v1.schema.json"},
        "tokenizer": {"$ref": "portable-component-ref.v1.schema.json"},
        "maximum_input_tokens": {"type": "integer", "minimum": 1, "maximum": 4294967295},
        "pooling": {"type": "string", "minLength": 1},
        "normalization": {"enum": ["l2", "none"]},
        "dimensions": {"type": "integer", "minimum": 1, "maximum": 4294967295},
        "dtype": {"const": "f32le"},
        "document_format": {
          "type": "string",
          "maxLength": 4096,
          "pattern": "^[^{}]*\\{semantic_text\\}[^{}]*$",
          "description": "Runtime validation applies the stricter 4096 UTF-8-byte format limit and 1048576 UTF-8-byte formatted-input limit."
        }
      }
    },
    "executable_tokenizer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "format", "model_revision", "target_tokenizer", "add_special_tokens", "maximum_input_bytes"],
      "properties": {
        "artifact": {"$ref": "portable-component-ref.v1.schema.json"},
        "format": {"const": "hugging_face_tokenizer_json"},
        "model_revision": {
          "type": "string",
          "minLength": 1,
          "description": "Frozen target model revision; the tokenizer artifact has its own source revision in artifact.version."
        },
        "target_tokenizer": {"$ref": "portable-component-ref.v1.schema.json"},
        "add_special_tokens": {"type": "boolean"},
        "maximum_input_bytes": {"$ref": "#/$defs/safe_positive"}
      }
    },
    "token_count_object": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "rows", "bytes", "sha256", "document_token_counts_sha256"],
      "properties": {
        "path": {"const": "token-counts/document-token-counts.u32le"},
        "rows": {"$ref": "#/$defs/safe_nonnegative"},
        "bytes": {"$ref": "#/$defs/safe_nonnegative"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "document_token_counts_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "token_statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_tokens", "p50_tokens", "p90_tokens", "p95_tokens",
        "p99_tokens", "maximum_tokens"
      ],
      "properties": {
        "total_tokens": {"$ref": "#/$defs/safe_nonnegative"},
        "p50_tokens": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "p90_tokens": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "p95_tokens": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "p99_tokens": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "maximum_tokens": {"type": "integer", "minimum": 0, "maximum": 4294967295}
      }
    },
    "slice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path", "object_sha256", "row_offset", "rows",
        "embedding_input_order_sha256", "token_count",
        "maximum_document_tokens", "document_token_counts_sha256"
      ],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "object_sha256": {"$ref": "#/$defs/sha256"},
        "row_offset": {"$ref": "#/$defs/safe_nonnegative"},
        "rows": {"$ref": "#/$defs/safe_positive"},
        "embedding_input_order_sha256": {"$ref": "#/$defs/sha256"},
        "token_count": {"$ref": "#/$defs/safe_positive"},
        "maximum_document_tokens": {"type": "integer", "minimum": 1, "maximum": 4294967295},
        "document_token_counts_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id", "ordinal_start", "ordinal_end", "input_slices",
        "embedding_input_order_sha256", "token_count", "maximum_document_tokens",
        "document_token_counts_sha256", "result_path", "receipt_path"
      ],
      "properties": {
        "task_id": {"$ref": "#/$defs/sha256"},
        "ordinal_start": {"$ref": "#/$defs/safe_nonnegative"},
        "ordinal_end": {"$ref": "#/$defs/safe_positive"},
        "input_slices": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/slice"}},
        "embedding_input_order_sha256": {"$ref": "#/$defs/sha256"},
        "token_count": {"$ref": "#/$defs/safe_positive"},
        "maximum_document_tokens": {"type": "integer", "minimum": 1, "maximum": 4294967295},
        "document_token_counts_sha256": {"$ref": "#/$defs/sha256"},
        "result_path": {"$ref": "#/$defs/path"},
        "receipt_path": {"$ref": "#/$defs/path"}
      }
    }
  }
}
