{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://livefire.dev/rag/evidence-embedding-row.v1.schema.json",
  "title": "Generic evidence document embedding row v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_id",
    "document_sha256",
    "purpose",
    "embedding_profile",
    "dimensions",
    "normalization",
    "vector"
  ],
  "properties": {
    "schema_version": {"const": "livefire.rag.evidence-embedding-row/1"},
    "document_id": {"type": "string", "minLength": 1, "maxLength": 512},
    "document_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "purpose": {"const": "semantic_search"},
    "embedding_profile": {"$ref": "https://livefire.dev/sdk/component-ref.v1.schema.json"},
    "dimensions": {"type": "integer", "minimum": 1, "maximum": 65536},
    "normalization": {"const": "l2"},
    "vector": {
      "type": "array",
      "minItems": 1,
      "maxItems": 65536,
      "items": {"type": "number"}
    }
  },
  "$comment": "Admission additionally requires finite float32 values, vector length equal to dimensions, one row per searchable document/profile, and the profile's declared L2 tolerance."
}
