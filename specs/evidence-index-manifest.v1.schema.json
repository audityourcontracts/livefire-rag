{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://livefire.dev/rag/evidence-index-manifest.v1.schema.json",
  "title": "Livefire immutable generic evidence index manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "component",
    "base_index_manifest",
    "index_format_descriptor",
    "physical_profile",
    "source_snapshots",
    "document_kinds",
    "row_schemas",
    "projection_policy",
    "derivation_policies",
    "embedding_profiles",
    "objects",
    "coverage",
    "query_contract"
  ],
  "properties": {
    "schema_version": {"const": "livefire.rag.evidence-index/1"},
    "component": {"$ref": "https://livefire.dev/sdk/component-ref.v1.schema.json"},
    "base_index_manifest": {"$ref": "https://livefire.dev/sdk/component-ref.v1.schema.json"},
    "index_format_descriptor": {"$ref": "https://livefire.dev/sdk/component-ref.v1.schema.json"},
    "physical_profile": {"$ref": "https://livefire.dev/sdk/component-ref.v1.schema.json"},
    "source_snapshots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "https://livefire.dev/sdk/component-ref.v1.schema.json"}
    },
    "document_kinds": {
      "const": [
        "activity",
        "state",
        "state_transition",
        "metric_window",
        "network_window",
        "entity",
        "detection",
        "structured_only"
      ]
    },
    "row_schemas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_document", "evidence_occurrence", "coverage_report"],
      "properties": {
        "evidence_document": {"$ref": "https://livefire.dev/sdk/component-ref.v1.schema.json"},
        "evidence_occurrence": {"$ref": "https://livefire.dev/sdk/component-ref.v1.schema.json"},
        "coverage_report": {"$ref": "https://livefire.dev/sdk/component-ref.v1.schema.json"}
      }
    },
    "projection_policy": {"$ref": "https://livefire.dev/sdk/component-ref.v1.schema.json"},
    "derivation_policies": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "https://livefire.dev/sdk/component-ref.v1.schema.json"}
    },
    "embedding_profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "https://livefire.dev/sdk/component-ref.v1.schema.json"}
    },
    "lexical_profile": {"$ref": "https://livefire.dev/sdk/component-ref.v1.schema.json"},
    "objects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documents", "occurrences", "embeddings", "coverage_report", "object_lock"],
      "properties": {
        "documents": {"$ref": "https://livefire.dev/sdk/artifact-ref.v1.schema.json"},
        "occurrences": {"$ref": "https://livefire.dev/sdk/artifact-ref.v1.schema.json"},
        "embeddings": {"$ref": "https://livefire.dev/sdk/artifact-ref.v1.schema.json"},
        "relations": {"$ref": "https://livefire.dev/sdk/artifact-ref.v1.schema.json"},
        "lexical_inputs": {"$ref": "https://livefire.dev/sdk/artifact-ref.v1.schema.json"},
        "coverage_report": {"$ref": "https://livefire.dev/sdk/artifact-ref.v1.schema.json"},
        "object_lock": {"$ref": "https://livefire.dev/sdk/artifact-ref.v1.schema.json"}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_record_count", "terminal_disposition_count", "document_count", "searchable_document_count", "unaccounted_record_count", "unresolved_pointer_count"],
      "properties": {
        "source_record_count": {"type": "integer", "minimum": 0},
        "terminal_disposition_count": {"type": "integer", "minimum": 0},
        "document_count": {"type": "integer", "minimum": 0},
        "searchable_document_count": {"type": "integer", "minimum": 0},
        "unaccounted_record_count": {"const": 0},
        "unresolved_pointer_count": {"const": 0}
      }
    },
    "query_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_format", "source_filters_apply_to_occurrences", "semantic_groups_preserve_occurrences", "derived_caches_authoritative", "candidate_results_are_evidence", "tie_break"],
      "properties": {
        "canonical_format": {"const": "parquet"},
        "source_filters_apply_to_occurrences": {"const": true},
        "semantic_groups_preserve_occurrences": {"const": true},
        "derived_caches_authoritative": {"const": false},
        "candidate_results_are_evidence": {"const": false},
        "tie_break": {"const": "ranking_score_desc_document_id_asc"}
      }
    }
  }
}
