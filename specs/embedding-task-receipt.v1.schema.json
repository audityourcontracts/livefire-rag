{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://livefire.dev/rag/embedding-task-receipt.v1.schema.json",
  "title": "Embedding vector result receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "component_sha256", "plan_sha256", "prepared_corpus_sha256", "embedding_profile_sha256", "task_id", "ordinal_start", "ordinal_end", "embedding_input_order_sha256", "vector", "executor", "finite_values_validated", "normalization_validated"],
  "properties": {
    "schema_version": {"const": "livefire.rag.vector-result-receipt/1"},
    "component_sha256": {"$ref": "#/$defs/sha256"}, "plan_sha256": {"$ref": "#/$defs/sha256"}, "prepared_corpus_sha256": {"$ref": "#/$defs/sha256"}, "embedding_profile_sha256": {"$ref": "#/$defs/sha256"},
    "task_id": {"type": "string", "minLength": 1}, "ordinal_start": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "ordinal_end": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}, "embedding_input_order_sha256": {"$ref": "#/$defs/sha256"},
    "vector": {"type": "object", "additionalProperties": false, "required": ["path", "rows", "bytes", "sha256", "dimensions", "dtype", "embedding_input_order_sha256"], "properties": {"path": {"$ref": "#/$defs/path"}, "rows": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}, "bytes": {"type": "integer", "minimum": 68, "maximum": 9007199254740991}, "sha256": {"$ref": "#/$defs/sha256"}, "dimensions": {"type": "integer", "minimum": 1, "maximum": 4294967295}, "dtype": {"const": "f32le"}, "embedding_input_order_sha256": {"$ref": "#/$defs/sha256"}}},
    "executor": {"type": "object", "additionalProperties": false, "required": ["implementation", "runtime", "returned_model", "requests", "retries", "input_bytes_upper_bound", "elapsed_ms", "conformance_passed"], "properties": {"implementation": {"$ref": "portable-component-ref.v1.schema.json"}, "runtime": {"$ref": "portable-component-ref.v1.schema.json"}, "returned_model": {"type": "string", "minLength": 1}, "requests": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}, "retries": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "input_bytes_upper_bound": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "elapsed_ms": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "conformance_passed": {"const": true}}},
    "finite_values_validated": {"const": true}, "normalization_validated": {"const": true}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)(?!.*:)(?!.*[/]$).+$"}},
  "$comment": "Contract validation compares every binding with the referenced plan task, requires executor conformance, enforces bytes = 64 + rows * dimensions * 4, and verifies the RFC 8785 digest with component_sha256 omitted."
}
