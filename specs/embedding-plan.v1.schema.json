{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://livefire.dev/rag/embedding-plan.v1.schema.json",
  "title": "Embedding plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "component_sha256", "prepared_corpus_sha256", "dataset", "embedding_profile", "document_count", "document_order_sha256", "tasks"],
  "properties": {
    "schema_version": {"const": "livefire.rag.embedding-plan/1"},
    "component_sha256": {"$ref": "#/$defs/sha256"},
    "prepared_corpus_sha256": {"$ref": "#/$defs/sha256"},
    "dataset": {"$ref": "portable-dataset-identity.v1.schema.json"},
    "embedding_profile": {"$ref": "#/$defs/profile"},
    "document_count": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "document_order_sha256": {"$ref": "#/$defs/sha256"},
    "tasks": {"type": "array", "items": {"$ref": "#/$defs/task"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)(?!.*:)(?!.*[/]$).+$"},
    "profile": {"type": "object", "additionalProperties": false, "required": ["id", "version", "sha256", "model_artifact", "tokenizer", "maximum_input_tokens", "pooling", "normalization", "dimensions", "dtype", "document_format"], "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}, "model_artifact": {"$ref": "portable-component-ref.v1.schema.json"}, "tokenizer": {"$ref": "portable-component-ref.v1.schema.json"}, "maximum_input_tokens": {"type": "integer", "minimum": 1, "maximum": 4294967295}, "pooling": {"type": "string", "minLength": 1}, "normalization": {"enum": ["l2", "none"]}, "dimensions": {"type": "integer", "minimum": 1, "maximum": 4294967295}, "dtype": {"const": "f32le"}, "document_format": {"type": "string", "minLength": 1}}},
    "slice": {"type": "object", "additionalProperties": false, "required": ["path", "object_sha256", "row_offset", "rows", "embedding_input_order_sha256"], "properties": {"path": {"$ref": "#/$defs/path"}, "object_sha256": {"$ref": "#/$defs/sha256"}, "row_offset": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "rows": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}, "embedding_input_order_sha256": {"$ref": "#/$defs/sha256"}}},
    "task": {"type": "object", "additionalProperties": false, "required": ["task_id", "ordinal_start", "ordinal_end", "input_slices", "embedding_input_order_sha256", "result_path", "receipt_path"], "properties": {"task_id": {"type": "string", "minLength": 1}, "ordinal_start": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "ordinal_end": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}, "input_slices": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/slice"}}, "embedding_input_order_sha256": {"$ref": "#/$defs/sha256"}, "result_path": {"$ref": "#/$defs/path"}, "receipt_path": {"$ref": "#/$defs/path"}}}
  },
  "$comment": "Contract validation requires tasks and their ordered input slices to cover [0, document_count) exactly once, with exact object, offset, row, and input-order-digest bindings."
}
