{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://livefire.dev/rag/benchmark-selection-manifest.v1.schema.json",
  "title": "Deterministic nested benchmark selection manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "component_sha256", "dataset", "dataset_sha256",
    "projection_policy", "selection_implementation", "selection_policy",
    "candidate_count", "candidate_universe_sha256", "selection_count",
    "selection_order_sha256", "selections", "targets"
  ],
  "properties": {
    "schema_version": {"const": "livefire.rag.benchmark-selection/1"},
    "component_sha256": {"$ref": "#/$defs/sha256"},
    "dataset": {"$ref": "portable-dataset-identity.v1.schema.json"},
    "dataset_sha256": {"$ref": "#/$defs/sha256"},
    "projection_policy": {"$ref": "portable-component-ref.v1.schema.json"},
    "selection_implementation": {"$ref": "portable-component-ref.v1.schema.json"},
    "selection_policy": {"$ref": "#/$defs/policy"},
    "candidate_count": {"$ref": "#/$defs/safe_positive"},
    "candidate_universe_sha256": {"$ref": "#/$defs/sha256"},
    "selection_count": {"const": 10000},
    "selection_order_sha256": {"$ref": "#/$defs/sha256"},
    "selections": {
      "type": "array",
      "minItems": 10000,
      "maxItems": 10000,
      "items": {"$ref": "benchmark-selection-row.v1.schema.json"}
    },
    "targets": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/target"}, {"properties": {"document_count": {"const": 512}}}]},
        {"allOf": [{"$ref": "#/$defs/target"}, {"properties": {"document_count": {"const": 2000}}}]},
        {"allOf": [{"$ref": "#/$defs/target"}, {"properties": {"document_count": {"const": 10000}}}]}
      ],
      "items": false
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "safe_nonnegative": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "safe_positive": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "length_stratum": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "minimum_utf8_bytes", "maximum_utf8_bytes"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "minimum_utf8_bytes": {"$ref": "#/$defs/safe_nonnegative"},
        "maximum_utf8_bytes": {
          "oneOf": [{"$ref": "#/$defs/safe_nonnegative"}, {"type": "null"}]
        }
      }
    },
    "quota": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relation", "length_stratum", "documents"],
      "properties": {
        "relation": {"type": "string", "minLength": 1},
        "length_stratum": {"type": "string", "minLength": 1},
        "documents": {"$ref": "#/$defs/safe_nonnegative"}
      }
    },
    "target_quota": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_count", "quotas"],
      "properties": {
        "document_count": {"enum": [512, 2000, 10000]},
        "quotas": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/quota"}}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "component_sha256", "algorithm", "selection_seed",
        "length_strata", "targets"
      ],
      "properties": {
        "schema_version": {"const": "livefire.rag.benchmark-selection-policy/1"},
        "component_sha256": {"$ref": "#/$defs/sha256"},
        "algorithm": {"const": "staged_stratified_sha256_v1"},
        "selection_seed": {"type": "string", "minLength": 1},
        "length_strata": {
          "type": "array", "minItems": 1, "items": {"$ref": "#/$defs/length_stratum"}
        },
        "targets": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            {"allOf": [{"$ref": "#/$defs/target_quota"}, {"properties": {"document_count": {"const": 512}}}]},
            {"allOf": [{"$ref": "#/$defs/target_quota"}, {"properties": {"document_count": {"const": 2000}}}]},
            {"allOf": [{"$ref": "#/$defs/target_quota"}, {"properties": {"document_count": {"const": 10000}}}]}
          ],
          "items": false
        }
      }
    },
    "prepared_corpus_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prepared_corpus_sha256", "dataset_sha256", "projection_policy_sha256",
        "document_count", "occurrence_count", "document_order_sha256",
        "embedding_input_order_sha256", "selected_documents_sha256"
      ],
      "properties": {
        "prepared_corpus_sha256": {"$ref": "#/$defs/sha256"},
        "dataset_sha256": {"$ref": "#/$defs/sha256"},
        "projection_policy_sha256": {"$ref": "#/$defs/sha256"},
        "document_count": {"enum": [512, 2000, 10000]},
        "occurrence_count": {"$ref": "#/$defs/safe_nonnegative"},
        "document_order_sha256": {"$ref": "#/$defs/sha256"},
        "embedding_input_order_sha256": {"$ref": "#/$defs/sha256"},
        "selected_documents_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_count", "quotas", "selection_prefix_sha256", "prepared_corpus"
      ],
      "properties": {
        "document_count": {"enum": [512, 2000, 10000]},
        "quotas": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/quota"}},
        "selection_prefix_sha256": {"$ref": "#/$defs/sha256"},
        "prepared_corpus": {"$ref": "#/$defs/prepared_corpus_identity"}
      }
    }
  },
  "$comment": "Runtime validation proves fixed target order and exact nesting, cumulative relation/length quotas, unique IDs and keys, contiguous ranks, safe integers, source/dataset/projection/key bindings, every target prefix digest, every prepared-corpus identity, and RFC 8785 component self-digests. Revalidation against the admitted candidate universe recomputes the complete scenario- and result-blind selection. Prepared object paths and file hashes remain transitively bound and validated by each referenced prepared-corpus component."
}
