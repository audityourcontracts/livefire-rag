{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://livefire.dev/rag/evidence-projection-pack.v1.schema.json",
  "title": "Livefire immutable generic evidence pre-embedding projection pack v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "component",
    "stage",
    "source_snapshots",
    "document_kinds",
    "row_schemas",
    "projection_policy",
    "derivation_policies",
    "physical_contract",
    "objects",
    "closure",
    "pointer_contract",
    "promotion_contract"
  ],
  "properties": {
    "schema_version": {"const": "livefire.rag.evidence-projection-pack/1"},
    "component": {"$ref": "https://livefire.dev/sdk/component-ref.v1.schema.json"},
    "stage": {"const": "pre_embedding_projection"},
    "source_snapshots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "https://livefire.dev/sdk/component-ref.v1.schema.json"}
    },
    "document_kinds": {
      "const": [
        "activity",
        "state",
        "state_transition",
        "metric_window",
        "network_window",
        "entity",
        "detection",
        "structured_only"
      ]
    },
    "row_schemas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_document", "evidence_occurrence", "coverage_report"],
      "properties": {
        "evidence_document": {"$ref": "https://livefire.dev/sdk/component-ref.v1.schema.json"},
        "evidence_occurrence": {"$ref": "https://livefire.dev/sdk/component-ref.v1.schema.json"},
        "coverage_report": {"$ref": "https://livefire.dev/sdk/component-ref.v1.schema.json"}
      }
    },
    "projection_policy": {"$ref": "https://livefire.dev/sdk/component-ref.v1.schema.json"},
    "derivation_policies": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "https://livefire.dev/sdk/component-ref.v1.schema.json"}
    },
    "physical_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documents_format", "occurrences_format", "encoding", "line_termination", "document_order", "occurrence_order"],
      "properties": {
        "documents_format": {"const": "canonical_jsonl"},
        "occurrences_format": {"const": "canonical_jsonl"},
        "encoding": {"const": "utf-8"},
        "line_termination": {"const": "lf"},
        "document_order": {"const": "document_id_asc"},
        "occurrence_order": {"const": "occurrence_id_asc"}
      }
    },
    "objects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documents", "occurrences", "coverage_report", "object_lock"],
      "properties": {
        "documents": {"$ref": "https://livefire.dev/sdk/artifact-ref.v1.schema.json"},
        "occurrences": {"$ref": "https://livefire.dev/sdk/artifact-ref.v1.schema.json"},
        "coverage_report": {"$ref": "https://livefire.dev/sdk/artifact-ref.v1.schema.json"},
        "object_lock": {"$ref": "https://livefire.dev/sdk/artifact-ref.v1.schema.json"}
      }
    },
    "closure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_record_count", "terminal_disposition_count", "document_count", "unaccounted_record_count", "multiply_dispositioned_record_count"],
      "properties": {
        "source_record_count": {"type": "integer", "minimum": 0},
        "terminal_disposition_count": {"type": "integer", "minimum": 0},
        "document_count": {"type": "integer", "minimum": 0},
        "unaccounted_record_count": {"const": 0},
        "multiply_dispositioned_record_count": {"const": 0}
      }
    },
    "pointer_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pointer_schema", "immutable_source_pointer_required", "all_pointers_resolved", "record_id_only_requires_local_pointer_table"],
      "properties": {
        "pointer_schema": {"$ref": "https://livefire.dev/sdk/component-ref.v1.schema.json"},
        "immutable_source_pointer_required": {"const": true},
        "all_pointers_resolved": {"const": true},
        "record_id_only_requires_local_pointer_table": {"const": true}
      }
    },
    "promotion_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["is_searchable_index", "embeddings_present", "promotion_requires"],
      "properties": {
        "is_searchable_index": {"const": false},
        "embeddings_present": {"const": false},
        "promotion_requires": {
          "const": [
            "admitted_projection_pack",
            "bound_embedding_profiles",
            "complete_searchable_document_embeddings",
            "canonical_parquet_materialization",
            "evidence_index_manifest"
          ]
        }
      }
    }
  }
}
