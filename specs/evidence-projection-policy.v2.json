      "_password",
      "_token"
    ],
    "secret_tokens": [
      "apikey",
      "passphrase",
      "passwd",
      "password",
      "secret",
      "token"
    ],
    "secret_token_combinations": [
      "api+key",
      "access+key",
      "private+key"
    ],
    "in_band_redaction_patterns": {
      "secret_assignment": "(?i)(?P<name>password|passwd|pwd|secret|token|api[-_]?key|access[-_]?key|authorization|cookie|private[-_]?key)(?P<sep>\\s*(?:=|:)\\s*|\\s+)(?P<value>\\\"[^\\\"]*\\\"|'[^']*'|[^\\s,;]+)",
      "bearer": "(?i)\\bbearer\\s+[A-Za-z0-9._~+/=-]+",
      "email": "(?<![\\w.+-])[\\w.+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}(?![\\w.-])",
      "ipv4": "(?<![\\w.])(?:25[0-5]|2[0-4]\\d|1?\\d?\\d)(?:\\.(?:25[0-5]|2[0-4]\\d|1?\\d?\\d)){3}(?![\\w.])",
      "uuid": "(?i)(?<![0-9a-f])[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![0-9a-f])",
      "long_hex": "(?i)(?<![0-9a-f])[0-9a-f]{32,}(?![0-9a-f])",
      "cloud_identifier": "(?i)\\barn:[a-z0-9-]+:[^\\s,;]+",
      "access_key": "\\b(?:AKIA|ASIA)[A-Z0-9]{16}\\b",
      "jwt": "(?<![A-Za-z0-9_-])[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}(?![A-Za-z0-9_-])",
      "mac": "(?i)(?<![0-9a-f])(?:[0-9a-f]{2}[:-]){5}[0-9a-f]{2}(?![0-9a-f])"
    }
  },
  "selection_policy": "closed_typed_relation_set_without_event-value_predicates",
  "unknown_or_unparsed_policy": "structured_only_occurrence"
}
