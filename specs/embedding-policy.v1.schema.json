{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://livefire.dev/rag/embedding-policy.v1.schema.json",
  "title": "Livefire RAG embedding profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "admission_status", "purpose", "model_repository", "model_revision", "model_artifact_set", "model_objects", "tokenizer", "runtime", "runtime_mode", "api_contract", "api_model_key", "dimensions", "dtype", "quantization", "pooling", "normalization", "maximum_tokens", "document_prefix", "query_instruction", "query_composition", "batching", "output_processing", "conformance"],
  "properties": {
    "schema_version": {"const": "livefire.rag.embedding-policy/1"},
    "admission_status": {"enum": ["development_only", "production_candidate"]},
    "purpose": {"enum": ["semantic_search", "action_novelty", "target_novelty"]},
    "model_repository": {"type": "string", "minLength": 1},
    "model_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "upstream_checkpoint": {"$ref": "https://livefire.dev/sdk/component-ref.v1.schema.json"},
    "model_artifact_set": {"$ref": "https://livefire.dev/sdk/component-ref.v1.schema.json"},
    "model_objects": {"type": "array", "minItems": 1, "items": {"$ref": "https://livefire.dev/sdk/artifact-ref.v1.schema.json"}},
    "conversion": {"$ref": "https://livefire.dev/sdk/component-ref.v1.schema.json"},
    "tokenizer": {"$ref": "https://livefire.dev/sdk/component-ref.v1.schema.json"},
    "runtime": {"$ref": "https://livefire.dev/sdk/component-ref.v1.schema.json"},
    "inference_engine": {"$ref": "https://livefire.dev/sdk/component-ref.v1.schema.json"},
    "load_policy": {"$ref": "https://livefire.dev/sdk/component-ref.v1.schema.json"},
    "runtime_mode": {"enum": ["pytorch_mps", "lmstudio_loopback"]},
    "api_contract": {"const": "openai_compatible_v1_embeddings"},
    "api_model_key": {"type": "string", "minLength": 1},
    "dimensions": {"enum": [1024, 2048, 4096]},
    "dtype": {"enum": ["float32", "float16", "bfloat16"]},
    "quantization": {"enum": ["none", "f16", "q8_0", "q4_k_m"]},
    "pooling": {"const": "last_token"},
    "normalization": {"const": "l2"},
    "maximum_tokens": {"type": "integer", "minimum": 1, "maximum": 8192},
    "document_prefix": {"type": "string", "maxLength": 4096},
    "query_instruction": {"type": "string", "maxLength": 4096},
    "query_composition": {"const": "Instruct: {query_instruction}\nQuery: {query}"},
    "batching": {
      "type": "object", "additionalProperties": false,
      "required": ["maximum_batch_items", "order", "overlength"],
      "properties": {
        "maximum_batch_items": {"type": "integer", "minimum": 1},
        "order": {"const": "preserve_input_order"},
        "overlength": {"const": "reject"}
      }
    },
    "output_processing": {
      "type": "object", "additionalProperties": false,
      "required": ["client_normalization", "required_l2_norm_tolerance_millionths"],
      "properties": {
        "client_normalization": {"const": "none"},
        "required_l2_norm_tolerance_millionths": {"type": "integer", "minimum": 0, "maximum": 1000000}
      }
    },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "fixture_sha256"],
      "properties": {
        "mode": {"enum": ["exact_digest", "numeric_tolerance"]},
        "fixture_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "normalized_output_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "expected_vectors": {"$ref": "https://livefire.dev/sdk/artifact-ref.v1.schema.json"},
        "tolerance_millionths": {"type": "integer", "minimum": 0}
      },
      "oneOf": [
        {"properties": {"mode": {"const": "exact_digest"}}, "required": ["normalized_output_sha256"]},
        {"properties": {"mode": {"const": "numeric_tolerance"}}, "required": ["expected_vectors", "tolerance_millionths"]}
      ]
    }
  },
  "allOf": [
    {"if": {"properties": {"admission_status": {"const": "production_candidate"}}}, "then": {"required": ["inference_engine", "load_policy"]}}
  ]
}
