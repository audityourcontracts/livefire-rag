{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://livefire.dev/rag/evaluation-suite-manifest.v1.schema.json",
  "title": "Livefire RAG sealed evaluation suite manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "suite_id", "suite_version", "corpus", "policies", "splits", "catalogues", "ground_truth", "metrics", "gates", "objects_lock"],
  "properties": {
    "schema_version": {"const": "livefire.rag.evaluation-suite/1"},
    "suite_id": {"type": "string", "minLength": 1},
    "suite_version": {"type": "string", "minLength": 1},
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["native_dataset", "ocsf_snapshot", "command_snapshot", "command_index"],
      "properties": {
        "native_dataset": {"$ref": "https://livefire.dev/sdk/component-ref.v1.schema.json"},
        "ocsf_snapshot": {"$ref": "https://livefire.dev/sdk/component-ref.v1.schema.json"},
        "command_snapshot": {"$ref": "https://livefire.dev/sdk/component-ref.v1.schema.json"},
        "command_index": {"$ref": "https://livefire.dev/sdk/component-ref.v1.schema.json"},
        "source_fidelity_audit": {"$ref": "https://livefire.dev/sdk/artifact-ref.v1.schema.json"}
      }
    },
    "policies": {
      "type": "object",
      "additionalProperties": {"$ref": "https://livefire.dev/sdk/component-ref.v1.schema.json"},
      "minProperties": 1
    },
    "splits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "seed", "development", "validation", "test", "test_sealed"],
      "properties": {
        "unit": {"const": "intent_group"},
        "seed": {"type": "integer", "minimum": 0},
        "development": {"$ref": "https://livefire.dev/sdk/artifact-ref.v1.schema.json"},
        "validation": {"$ref": "https://livefire.dev/sdk/artifact-ref.v1.schema.json"},
        "test": {"$ref": "https://livefire.dev/sdk/artifact-ref.v1.schema.json"},
        "test_sealed": {"const": true}
      }
    },
    "catalogues": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conformance_tests", "queries", "similarity_seeds", "anomaly_candidates", "hard_negatives"],
      "properties": {
        "conformance_tests": {"$ref": "https://livefire.dev/sdk/artifact-ref.v1.schema.json"},
        "queries": {"$ref": "https://livefire.dev/sdk/artifact-ref.v1.schema.json"},
        "similarity_seeds": {"$ref": "https://livefire.dev/sdk/artifact-ref.v1.schema.json"},
        "anomaly_candidates": {"$ref": "https://livefire.dev/sdk/artifact-ref.v1.schema.json"},
        "hard_negatives": {"$ref": "https://livefire.dev/sdk/artifact-ref.v1.schema.json"}
      }
    },
    "ground_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["qrels", "predicates", "anomaly_labels", "adjudication_receipt", "duplicate_group_policy"],
      "properties": {
        "qrels": {"$ref": "https://livefire.dev/sdk/artifact-ref.v1.schema.json"},
        "predicates": {"$ref": "https://livefire.dev/sdk/artifact-ref.v1.schema.json"},
        "anomaly_labels": {"$ref": "https://livefire.dev/sdk/artifact-ref.v1.schema.json"},
        "adjudication_receipt": {"$ref": "https://livefire.dev/sdk/artifact-ref.v1.schema.json"},
        "duplicate_group_policy": {"$ref": "https://livefire.dev/sdk/component-ref.v1.schema.json"}
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "gates": {"$ref": "https://livefire.dev/sdk/component-ref.v1.schema.json"},
    "objects_lock": {"$ref": "https://livefire.dev/sdk/artifact-ref.v1.schema.json"}
  }
}
