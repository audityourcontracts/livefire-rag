{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://livefire.dev/rag/rag-search.output.v1.schema.json",
  "title": "rag.search pointer result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "snapshot", "index", "coverage", "pointers"],
  "properties": {
    "kind": { "const": "pointer" },
    "snapshot": { "$ref": "#/$defs/binding" },
    "index": { "$ref": "#/$defs/binding" },
    "query_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "definitive", "indexed_documents", "eligible_documents"],
      "properties": {
        "status": { "enum": ["complete", "truncated", "partial", "unavailable"] },
        "definitive": { "const": false },
        "indexed_documents": { "type": "integer", "minimum": 0 },
        "eligible_documents": { "type": "integer", "minimum": 0 },
        "reason_codes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "pointers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_ref", "rank", "score_millionths", "projection_sha256"],
        "properties": {
          "source_ref": { "type": "string", "minLength": 1 },
          "rank": { "type": "integer", "minimum": 1 },
          "score_millionths": { "type": "integer" },
          "projection_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "excerpt": { "type": "string", "maxLength": 2048 }
        }
      }
    }
  },
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
