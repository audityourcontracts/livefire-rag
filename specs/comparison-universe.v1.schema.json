{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://livefire.dev/rag/comparison-universe.v1.schema.json",
  "title": "Command comparison universe v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "universe_id", "tenant_scope_sha256", "identity_policy", "population_policy", "source_snapshots"],
  "properties": {
    "schema_version": {"const": "livefire.rag.comparison-universe/1"},
    "universe_id": {"type": "string", "minLength": 1},
    "tenant_scope_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identity_policy": {"$ref": "https://livefire.dev/sdk/component-ref.v1.schema.json"},
    "population_policy": {"$ref": "https://livefire.dev/sdk/component-ref.v1.schema.json"},
    "source_snapshots": {"type": "array", "minItems": 1, "items": {"$ref": "https://livefire.dev/sdk/component-ref.v1.schema.json"}}
  }
}
