{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://livefire.dev/rag/evidence-search.output.v1.schema.json",
  "title": "evidence.search ranked candidate-pointer output v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "tool",
    "index",
    "source_snapshots",
    "query_sha256",
    "coverage",
    "selection"
  ],
  "properties": {
    "schema_version": {"const": "livefire.rag.evidence-search.output/1"},
    "kind": {"enum": ["pointer", "miss"]},
    "tool": {"const": "evidence.search"},
    "index": {"$ref": "https://livefire.dev/sdk/component-ref.v1.schema.json"},
    "source_snapshots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "https://livefire.dev/sdk/component-ref.v1.schema.json"}
    },
    "query_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "indexed_documents", "eligible_documents", "eligible_occurrences", "definitive", "reason_codes"],
      "properties": {
        "status": {"enum": ["complete", "partial", "unavailable"]},
        "indexed_documents": {"type": "integer", "minimum": 0},
        "eligible_documents": {"type": "integer", "minimum": 0},
        "eligible_occurrences": {"type": "integer", "minimum": 0},
        "definitive": {"const": false},
        "reason_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}}
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested_top_n", "returned_count", "eligible_count", "exhausted", "deterministic", "tie_break"],
      "properties": {
        "requested_top_n": {"type": "integer", "minimum": 1},
        "returned_count": {"type": "integer", "minimum": 0},
        "eligible_count": {"type": "integer", "minimum": 0},
        "exhausted": {"type": "boolean"},
        "deterministic": {"const": true},
        "tie_break": {"const": "ranking_score_desc_document_id_asc"}
      }
    },
    "miss": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "message"],
      "properties": {
        "reason": {"enum": ["no_eligible_occurrences", "no_ranked_candidates"]},
        "message": {"type": "string", "minLength": 1, "maxLength": 1024}
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/candidate"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "pointer"}}, "required": ["kind"]},
      "then": {"required": ["candidates"], "not": {"required": ["miss"]}}
    },
    {
      "if": {"properties": {"kind": {"const": "miss"}}, "required": ["kind"]},
      "then": {"required": ["miss"], "not": {"required": ["candidates"]}}
    }
  ],
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rank", "document_id", "document_sha256", "document_kind", "preview", "scores", "matched_facets", "matching_occurrence_count", "returned_occurrence_count", "occurrences_exhausted", "source_occurrences"],
      "properties": {
        "rank": {"type": "integer", "minimum": 1},
        "document_id": {"type": "string", "minLength": 1, "maxLength": 512},
        "document_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "document_kind": {"enum": ["activity", "state", "state_transition", "metric_window", "network_window", "entity", "detection"]},
        "preview": {"type": "string", "maxLength": 4096},
        "scores": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ranking_score_millionths", "dense_distance_millionths", "lexical_score_millionths", "fused_score_millionths"],
          "properties": {
            "ranking_score_millionths": {"type": "integer", "minimum": 0},
            "dense_distance_millionths": {"type": ["integer", "null"], "minimum": 0, "maximum": 2000000},
            "lexical_score_millionths": {"type": ["integer", "null"], "minimum": 0},
            "fused_score_millionths": {"type": ["integer", "null"], "minimum": 0}
          }
        },
        "matched_facets": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "https://livefire.dev/rag/evidence-common.v1.schema.json#/$defs/facet"}
        },
        "matching_occurrence_count": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of this document's occurrences that satisfy the request filters."
        },
        "returned_occurrence_count": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of matching occurrences materialized in source_occurrences."
        },
        "occurrences_exhausted": {
          "type": "boolean",
          "description": "True only when every matching occurrence is returned."
        },
        "source_occurrences": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["occurrence_id", "relation_identity", "source_pointer"],
            "properties": {
              "occurrence_id": {"type": "string", "minLength": 1, "maxLength": 512},
              "event_time": {"type": "string", "format": "date-time"},
              "relation_identity": {"$ref": "https://livefire.dev/rag/evidence-common.v1.schema.json#/$defs/relation_identity"},
              "source_pointer": {"$ref": "https://livefire.dev/sdk/source-record-pointer.v1.schema.json"}
            }
          }
        }
      }
    }
  }
}
