{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://livefire.dev/rag/evidence-search.input.v1.schema.json",
  "title": "evidence.search input v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "query", "top_n", "retrieval"],
  "properties": {
    "schema_version": {"const": "livefire.rag.evidence-search.input/1"},
    "query": {"type": "string", "minLength": 1, "maxLength": 8192},
    "top_n": {"type": "integer", "minimum": 1, "maximum": 1000},
    "time_range": {"$ref": "https://livefire.dev/rag/evidence-common.v1.schema.json#/$defs/time_range"},
    "retrieval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["methods", "fusion"],
      "properties": {
        "methods": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"enum": ["dense", "lexical"]}
        },
        "fusion": {"enum": ["none", "reciprocal_rank"]}
      }
    },
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "document_kinds": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "https://livefire.dev/rag/evidence-common.v1.schema.json#/$defs/document_kind"}
        },
        "relations": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "https://livefire.dev/rag/evidence-common.v1.schema.json#/$defs/relation_identity"}
        },
        "ocsf_category_uids": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
        "ocsf_class_uids": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
        "ocsf_activity_ids": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
        "source_snapshot_sha256": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
        "entity_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 512}},
        "attribute_predicates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["namespace", "path", "operator", "value"],
            "properties": {
              "namespace": {"type": "string", "minLength": 1, "maxLength": 256},
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "pattern": "^/(?:[^~/]|~[01])*(?:/(?:[^~/]|~[01])*)*$"
              },
              "operator": {"enum": ["eq", "not_eq", "lt", "lte", "gt", "gte"]},
              "value": {"$ref": "https://livefire.dev/rag/evidence-common.v1.schema.json#/$defs/typed_scalar"}
            }
          }
        },
        "exclude_document_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 512}}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"retrieval": {"properties": {"methods": {"maxItems": 1}}, "required": ["methods"]}}, "required": ["retrieval"]},
      "then": {"properties": {"retrieval": {"properties": {"fusion": {"const": "none"}}}}}
    },
    {
      "if": {"properties": {"retrieval": {"properties": {"methods": {"minItems": 2}}, "required": ["methods"]}}, "required": ["retrieval"]},
      "then": {"properties": {"retrieval": {"properties": {"fusion": {"const": "reciprocal_rank"}}}}}
    }
  ]
}
