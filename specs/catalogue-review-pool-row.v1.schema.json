{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://livefire.dev/rag/catalogue-review-pool-row.v1.schema.json",
  "title": "Label-hidden catalogue review candidate row v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "query_id", "query", "dataset_id", "document_id", "semantic_text", "eligible_occurrence_count", "occurrences"],
  "properties": {
    "schema_version": {"const": "livefire.rag.catalogue-review-pool-row/1"},
    "candidate_id": {"type": "string", "pattern": "^candidate-[0-9a-f]{64}$"},
    "query_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S"},
    "query": {"type": "string", "minLength": 1, "maxLength": 8192, "pattern": "\\S"},
    "dataset_id": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "\\S"},
    "document_id": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "\\S"},
    "semantic_text": {"type": "string", "minLength": 1, "maxLength": 1048576, "pattern": "\\S"},
    "eligible_occurrence_count": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "occurrences": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/occurrence"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "occurrence": {
      "type": "object", "additionalProperties": false,
      "required": ["event_time_ms", "relation", "snapshot_sha256", "mapping_sha256", "event_id", "support_ref"],
      "properties": {
        "event_time_ms": {"type": ["integer", "null"], "minimum": 0},
        "relation": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "\\S"},
        "snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "mapping_sha256": {"$ref": "#/$defs/sha256"},
        "event_id": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "\\S"},
        "support_ref": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "\\S"}
      }
    }
  },
  "$comment": "This contract deliberately excludes retrieval mode, ranks, scores, index/catalogue/system identity, labels, and expected-relation hints so people can mark relevance without seeing system labels."
}
