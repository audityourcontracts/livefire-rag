{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://livefire.dev/rag/benchmark-selection-row.v1.schema.json",
  "title": "Deterministic benchmark selection row v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "selection_rank", "document_id", "document_sha256", "semantic_text_sha256",
    "semantic_text_utf8_bytes", "primary_relation", "length_stratum",
    "selection_key_sha256"
  ],
  "properties": {
    "selection_rank": {"$ref": "#/$defs/safe_nonnegative"},
    "document_id": {"type": "string", "minLength": 1},
    "document_sha256": {"$ref": "#/$defs/sha256"},
    "semantic_text_sha256": {"$ref": "#/$defs/sha256"},
    "semantic_text_utf8_bytes": {"$ref": "#/$defs/safe_positive"},
    "primary_relation": {"type": "string", "minLength": 1},
    "length_stratum": {"type": "string", "minLength": 1},
    "selection_key_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "safe_nonnegative": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "safe_positive": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
  },
  "$comment": "Runtime validation requires ranks to be contiguous from zero, document IDs and keys to be unique, the declared length stratum to contain the UTF-8 byte length, and the key to be recomputed from only the bound source, dataset, projection, policy, relation, document, and input identities."
}
