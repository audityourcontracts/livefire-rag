{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://livefire.dev/rag/fast-index-manifest.v4.schema.json",
  "title": "Deterministic test-vector fast index manifest v4",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "component_sha256", "source", "build_scope", "complete", "documents", "occurrences", "vectors", "lexical", "occurrence_lookup", "embedding_profile", "pipeline_provenance", "test_only"],
  "properties": {
    "schema_version": {"const": "livefire.rag.fast-index/4"},
    "component_sha256": {"$ref": "fast-index-manifest.v3.schema.json#/$defs/sha256"},
    "source": {"$ref": "fast-index-manifest.v3.schema.json#/$defs/source"},
    "build_scope": {"enum": ["full", "sample"]},
    "complete": {"type": "boolean"},
    "documents": {"$ref": "fast-index-manifest.v3.schema.json#/$defs/row_object"},
    "occurrences": {"$ref": "fast-index-manifest.v3.schema.json#/$defs/row_object"},
    "vectors": {"$ref": "fast-index-manifest.v3.schema.json#/$defs/vectors"},
    "lexical": {
      "oneOf": [
        {"$ref": "fast-index-manifest.v2.schema.json#/$defs/lexical"},
        {"$ref": "fast-index-manifest.v3.schema.json#/$defs/lexical"}
      ]
    },
    "occurrence_lookup": {"$ref": "fast-index-manifest.v3.schema.json#/$defs/lookup"},
    "embedding_profile": {"$ref": "fast-index-manifest.v3.schema.json#/$defs/embedding"},
    "pipeline_provenance": {"$ref": "fast-index-manifest.v3.schema.json#/$defs/pipeline_provenance"},
    "test_only": {"const": true}
  },
  "$comment": "Version 4 is diagnostic-only and may use either v2 JSON lexical storage or v3 SQLite lexical storage. Normal query and provider paths must refuse it."
}
