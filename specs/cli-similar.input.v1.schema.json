{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://livefire.dev/rag/cli-similar.input.v1.schema.json",
  "title": "cli.similar input v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "command_id", "top_n"],
  "properties": {
    "schema_version": {"const": "livefire.rag.cli-similar.input/1"},
    "command_id": {"type": "string", "minLength": 1},
    "top_n": {"type": "integer", "minimum": 1, "maximum": 1000},
    "exclude_seed": {"type": "boolean", "default": true},
    "time_range": {"$ref": "https://livefire.dev/rag/cli-common.v1.schema.json#/$defs/time_range"},
    "filters": {"$ref": "https://livefire.dev/rag/cli-common.v1.schema.json#/$defs/filters"}
  }
}
