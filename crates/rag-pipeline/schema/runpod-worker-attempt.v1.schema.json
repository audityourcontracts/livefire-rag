{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://livefire.dev/rag/runpod-worker-attempt.v1.schema.json",
  "title": "RunPod worker attempt marker",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "component_sha256", "bundle_sha256", "assignment_sha256", "worker_id", "attempt_id", "attempt_number", "outcome", "machine", "execution", "started_at_ms", "completed_at_ms", "requests", "retries", "outputs"],
  "properties": {
    "schema_version": {"const": "livefire.rag.runpod-worker-attempt/1"},
    "component_sha256": {"$ref": "#/$defs/digest"}, "bundle_sha256": {"$ref": "#/$defs/digest"}, "assignment_sha256": {"$ref": "#/$defs/digest"},
    "worker_id": {"$ref": "#/$defs/identifier"}, "attempt_id": {"$ref": "#/$defs/identifier"},
    "attempt_number": {"type": "integer", "minimum": 1, "maximum": 4294967295},
    "outcome": {"enum": ["completed", "failed"]},
    "machine": {
      "type": "object", "additionalProperties": false, "required": ["pod_id", "machine_id"],
      "properties": {"pod_id": {"$ref": "#/$defs/identifier"}, "machine_id": {"$ref": "#/$defs/identifier"}}
    },
    "execution": {"$ref": "#/$defs/execution"},
    "started_at_ms": {"$ref": "#/$defs/safeInteger"}, "completed_at_ms": {"$ref": "#/$defs/safeInteger"},
    "requests": {"$ref": "#/$defs/safeInteger"}, "retries": {"$ref": "#/$defs/safeInteger"},
    "outputs": {"type": "array", "items": {"$ref": "#/$defs/taskOutput"}},
    "query_vector_set": {"$ref": "#/$defs/queryVectorSet"},
    "failure_code": {"$ref": "#/$defs/identifier"}
  },
  "allOf": [
    {"if": {"properties": {"outcome": {"const": "completed"}}}, "then": {"not": {"required": ["failure_code"]}}},
    {"if": {"properties": {"outcome": {"const": "failed"}}}, "then": {"required": ["failure_code"], "properties": {"outputs": {"maxItems": 0}}, "not": {"required": ["query_vector_set"]}}},
    {"if": {"properties": {"worker_id": {"const": "worker-0000"}, "outcome": {"const": "completed"}}, "required": ["worker_id", "outcome"]}, "then": {"required": ["query_vector_set"]}},
    {"if": {"not": {"properties": {"worker_id": {"const": "worker-0000"}}, "required": ["worker_id"]}}, "then": {"not": {"required": ["query_vector_set"]}}}
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._-]+$"},
    "text": {"type": "string", "minLength": 1},
    "boundedText": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$"},
    "safeInteger": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "positiveSafeInteger": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*//)(?!.*[\\\\:])[^/]+(?:/[^/]+)*$"},
    "component": {"type": "object", "additionalProperties": false, "required": ["id", "version", "sha256"], "properties": {"id": {"$ref": "#/$defs/text"}, "version": {"$ref": "#/$defs/text"}, "sha256": {"$ref": "#/$defs/digest"}}},
    "accelerator": {"type": "object", "additionalProperties": false, "required": ["provider", "model", "architecture", "compute_capability", "count"], "properties": {"provider": {"$ref": "#/$defs/boundedText"}, "model": {"$ref": "#/$defs/boundedText"}, "architecture": {"$ref": "#/$defs/boundedText"}, "compute_capability": {"$ref": "#/$defs/boundedText"}, "count": {"const": 1}}},
    "execution": {"type": "object", "additionalProperties": false, "required": ["executor_image", "executor_image_build", "runtime", "worker_binary", "model_artifact", "embedding_profile", "accelerator", "returned_model"], "properties": {"executor_image": {"$ref": "#/$defs/component"}, "executor_image_build": {"$ref": "#/$defs/component"}, "runtime": {"$ref": "#/$defs/component"}, "worker_binary": {"$ref": "#/$defs/component"}, "model_artifact": {"$ref": "#/$defs/component"}, "embedding_profile": {"$ref": "#/$defs/component"}, "accelerator": {"$ref": "#/$defs/accelerator"}, "returned_model": {"$ref": "#/$defs/text"}}},
    "object": {"type": "object", "additionalProperties": false, "required": ["key", "bytes", "sha256"], "properties": {"key": {"$ref": "#/$defs/path"}, "bytes": {"$ref": "#/$defs/positiveSafeInteger"}, "sha256": {"$ref": "#/$defs/digest"}}},
    "taskOutput": {"type": "object", "additionalProperties": false, "required": ["task_id", "result", "receipt", "report"], "properties": {"task_id": {"$ref": "#/$defs/identifier"}, "result": {"$ref": "#/$defs/object"}, "receipt": {"$ref": "#/$defs/object"}, "report": {"$ref": "#/$defs/object"}}},
    "queryVectorSet": {"type": "object", "additionalProperties": false, "required": ["component_sha256", "manifest", "query_plan", "vectors"], "properties": {"component_sha256": {"$ref": "#/$defs/digest"}, "manifest": {"$ref": "#/$defs/object"}, "query_plan": {"$ref": "#/$defs/object"}, "vectors": {"$ref": "#/$defs/object"}}}
  }
}
