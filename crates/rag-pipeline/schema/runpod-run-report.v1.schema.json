{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://livefire.dev/rag/runpod-run-report.v1.schema.json",
  "title": "RunPod embedding run coverage report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "component_sha256", "bundle_sha256", "execution", "worker_count", "task_count", "document_count", "total_tokens", "vector_objects", "receipt_objects", "report_objects", "query_vector_set", "selected_attempts"],
  "properties": {
    "schema_version": {"const": "livefire.rag.runpod-run-report/1"},
    "component_sha256": {"$ref": "#/$defs/digest"}, "bundle_sha256": {"$ref": "#/$defs/digest"},
    "execution": {"$ref": "#/$defs/execution"},
    "worker_count": {"type": "integer", "minimum": 1, "maximum": 65535},
    "task_count": {"type": "integer", "minimum": 1, "maximum": 4294967295},
    "document_count": {"$ref": "#/$defs/safeInteger"}, "total_tokens": {"$ref": "#/$defs/positiveSafeInteger"},
    "vector_objects": {"type": "integer", "minimum": 1, "maximum": 4294967295},
    "receipt_objects": {"type": "integer", "minimum": 1, "maximum": 4294967295},
    "report_objects": {"type": "integer", "minimum": 1, "maximum": 4294967295},
    "query_vector_set": {"$ref": "#/$defs/queryVectorSet"},
    "selected_attempts": {"type": "array", "minItems": 1, "maxItems": 65535, "items": {"$ref": "#/$defs/selectedAttempt"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._-]+$"},
    "text": {"type": "string", "minLength": 1},
    "boundedText": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$"},
    "safeInteger": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "positiveSafeInteger": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*//)(?!.*[\\\\:])[^/]+(?:/[^/]+)*$"},
    "component": {"type": "object", "additionalProperties": false, "required": ["id", "version", "sha256"], "properties": {"id": {"$ref": "#/$defs/text"}, "version": {"$ref": "#/$defs/text"}, "sha256": {"$ref": "#/$defs/digest"}}},
    "accelerator": {"type": "object", "additionalProperties": false, "required": ["provider", "model", "architecture", "compute_capability", "count"], "properties": {"provider": {"$ref": "#/$defs/boundedText"}, "model": {"$ref": "#/$defs/boundedText"}, "architecture": {"$ref": "#/$defs/boundedText"}, "compute_capability": {"$ref": "#/$defs/boundedText"}, "count": {"const": 1}}},
    "execution": {"type": "object", "additionalProperties": false, "required": ["executor_image", "executor_image_build", "runtime", "worker_binary", "model_artifact", "embedding_profile", "accelerator", "returned_model"], "properties": {"executor_image": {"$ref": "#/$defs/component"}, "executor_image_build": {"$ref": "#/$defs/component"}, "runtime": {"$ref": "#/$defs/component"}, "worker_binary": {"$ref": "#/$defs/component"}, "model_artifact": {"$ref": "#/$defs/component"}, "embedding_profile": {"$ref": "#/$defs/component"}, "accelerator": {"$ref": "#/$defs/accelerator"}, "returned_model": {"$ref": "#/$defs/text"}}},
    "object": {"type": "object", "additionalProperties": false, "required": ["key", "bytes", "sha256"], "properties": {"key": {"$ref": "#/$defs/path"}, "bytes": {"$ref": "#/$defs/positiveSafeInteger"}, "sha256": {"$ref": "#/$defs/digest"}}},
    "selectedAttempt": {"type": "object", "additionalProperties": false, "required": ["worker_id", "attempt_id", "marker_component_sha256", "marker"], "properties": {"worker_id": {"$ref": "#/$defs/identifier"}, "attempt_id": {"$ref": "#/$defs/identifier"}, "marker_component_sha256": {"$ref": "#/$defs/digest"}, "marker": {"$ref": "#/$defs/object"}}},
    "queryVectorSet": {"type": "object", "additionalProperties": false, "required": ["component_sha256", "manifest", "query_plan", "vectors"], "properties": {"component_sha256": {"$ref": "#/$defs/digest"}, "manifest": {"$ref": "#/$defs/object"}, "query_plan": {"$ref": "#/$defs/object"}, "vectors": {"$ref": "#/$defs/object"}}}
  }
}
